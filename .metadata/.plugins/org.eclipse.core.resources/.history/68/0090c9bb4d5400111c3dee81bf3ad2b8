@RestController
@RequestMapping("/hotels")
public class HotelController {
@Autowired
	private HotelService hotelService;
	

	//create
@PostMapping
ResponseEntity<Hotel> createHotel(@RequestBody  Hotel hotel)
{
	Hotel hotel2 = hotelService.createHotel(hotel);
	return ResponseEntity.status(HttpStatus.CREATED).body(hotel2);
}

@GetMapping("/{hotelId}")
ResponseEntity<?> getHotelById(@PathVariable String hotelId)
{
	
	//Traditional way to handle Exception handling
	try
	{
	Hotel hotel2 = hotelService.gethotel(hotelId);
	return ResponseEntity.status(HttpStatus.OK).body(hotel2);
	}
	catch(ResourceNotFoundEx e)
	{
		ErrorResponse errorResponse=new ErrorResponse(LocalDateTime.now(),e.toString(),"HOtel not found for "+hotelId);
		return ResponseEntity.status(HttpStatus.NOT_FOUND).body(errorResponse);
	}	
	
}

