//Common Method for Same type of exception in multiple api

@ExceptionHandler(ResourceNotFoundEx.class)
public ResponseEntity<?> handleHotelNotFoundEx(ResourceNotFoundEx e)
{
	ErrorResponse errorResponse=new ErrorResponse(LocalDateTime.now(),e.getMessage(),"Hotel not found !!");
	return ResponseEntity.status(HttpStatus.NOT_FOUND).body(errorResponse);
	
}

